# Copia este fichero como .env y rellena los valores. .env no se sube a git.

# Ingesta: clave de la API de la ACB
ACB_API_KEY=

# Despliegue en Hugging Face (scripts/publish_db.py y scripts/deploy_space.py)
HF_TOKEN=
# token de solo lectura que usará el Space para bajar la base (si falta, usa HF_TOKEN)
HF_READ_TOKEN=
ACB_DB_DATASET=tu_usuario/acb-statistics-db
HF_SPACE=tu_usuario/acb-statistics
